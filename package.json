{
  "name": "paigaam",
  "version": "0.1.0",
  "description": "Paigaam \u2014 beautiful greetings, made personal.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/prepare-ganapati.js",
    "postinstall": "node scripts/prepare-ganapati.js",
    "test": "node scripts/test-ganapati.js && node scripts/test-saalgirah.js && node scripts/test-courtyard.js && node scripts/test-lavender.js && node scripts/test-valentine.js && node scripts/test-love.js && node scripts/test-maafi.js && node --test tests/qr-card.test.js && node scripts/test-sauwajah.js && node scripts/test-sawaal.js",
    "test:saalgirah": "node scripts/test-saalgirah.js",
    "test:ganapati": "node scripts/test-ganapati.js",
    "test:courtyard": "node scripts/test-courtyard.js",
    "test:lavender": "node scripts/test-lavender.js",
    "test:valentine": "node scripts/test-valentine.js",
    "test:love": "node scripts/test-love.js",
    "test:maafi": "node scripts/test-maafi.js",
    "test:sauwajah": "node scripts/test-sauwajah.js",
    "test:sawaal": "node scripts/test-sawaal.js"
  },
  "engines": {
    "node": ">=22.5.0 <25"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
